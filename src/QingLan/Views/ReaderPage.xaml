<Page x:Class="QingLan.Views.ReaderPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" NavigationCacheMode="Enabled">
  <Grid RowSpacing="12" Margin="24,14,24,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <CommandBar Background="Transparent" DefaultLabelPosition="Right" OverflowButtonVisibility="Auto" HorizontalContentAlignment="Stretch">
      <CommandBar.Content><Button Content="← 返回" Click="Back_Click" Padding="14,10" Background="Transparent" BorderThickness="0"/></CommandBar.Content>
      <AppBarButton x:Name="FavoriteButton" Label="收藏" Icon="Favorite" Click="Favorite_Click"/>
      <AppBarButton Label="随心记" Icon="Edit" Click="Write_Click"/>
      <AppBarButton Label="字体" Icon="Font">
        <AppBarButton.Flyout><Flyout x:Name="ReadingOptions" Opened="ReadingOptions_Opened" Closed="ReadingOptions_Closed"><StackPanel Width="260" Spacing="14" Padding="8">
          <TextBlock Text="阅读字号" FontSize="16"/>
          <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Button x:Name="SmallSize" Content="小 · 18" Tag="0" Click="FontSize_Click" HorizontalAlignment="Stretch"/>
            <Button x:Name="NormalSize" Grid.Column="1" Content="标准 · 21" Tag="1" Click="FontSize_Click" HorizontalAlignment="Stretch"/>
            <Button x:Name="LargeSize" Grid.Row="1" Content="大 · 25" Tag="2" Click="FontSize_Click" HorizontalAlignment="Stretch"/>
            <Button x:Name="ExtraLargeSize" Grid.Row="1" Grid.Column="1" Content="特大 · 29" Tag="3" Click="FontSize_Click" HorizontalAlignment="Stretch"/>
          </Grid>
          <TextBlock Text="正文字体" FontSize="16"/>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="SongFont" Content="宋体" Tag="宋体" Click="FontFamily_Click" FontFamily="SimSun" Padding="10,12" HorizontalAlignment="Stretch"/>
            <Button x:Name="KaiFont" Grid.Column="1" Content="楷体" Tag="楷体" Click="FontFamily_Click" FontFamily="KaiTi" Padding="10,12" HorizontalAlignment="Stretch"/>
            <Button x:Name="FangFont" Grid.Column="2" Content="仿宋" Tag="仿宋" Click="FontFamily_Click" FontFamily="FangSong" Padding="10,12" HorizontalAlignment="Stretch"/>
          </Grid>
          <TextBlock x:Name="FontStatus" FontSize="12" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
          <TextBlock Text="点击即应用于正文，并记住你的选择。" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        </StackPanel></Flyout></AppBarButton.Flyout>
      </AppBarButton>
      <AppBarButton Label="全屏" Icon="FullScreen" Click="FullScreen_Click"/>
      <CommandBar.SecondaryCommands><AppBarButton x:Name="DeleteButton" Label="删除随心记" Icon="Delete" Click="Delete_Click"/></CommandBar.SecondaryCommands>
    </CommandBar>
    <ScrollViewer x:Name="ReaderScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ViewChanged="ReaderScroll_ViewChanged">
      <Border x:Name="Paper" MaxWidth="880" HorizontalAlignment="Stretch" Background="#FCFBF6" CornerRadius="22" Padding="52,44,52,50" Margin="0,0,0,16" BorderBrush="#E3E7DC" BorderThickness="1">
        <StackPanel Spacing="23">
          <TextBlock x:Name="SourceTag" FontSize="12" CharacterSpacing="160" Foreground="{StaticResource Accent}"/>
          <TextBlock x:Name="ArticleTitle" FontSize="40" FontFamily="{StaticResource Literary}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ArticleMeta" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <Rectangle Height="1" Fill="#DCE2D9" Margin="0,5,0,8"/>
          <RichTextBlock x:Name="Body" FontFamily="{StaticResource ReadingFont}" FontSize="21" LineHeight="40" Foreground="#30454A" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
          <HyperlinkButton x:Name="SourceLink" Content="查看维基文库原文与版权说明 ↗" HorizontalAlignment="Left" FontSize="12" Margin="0,14,0,0"/>
          <TextBlock Text="—  读到这里，给心留一点余白  —" HorizontalAlignment="Center" FontFamily="{StaticResource Literary}" Foreground="#83968E" FontSize="18" Margin="0,18,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </ScrollViewer>
    <Grid Grid.Row="2" Padding="10,0,10,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ProgressLabel" FontSize="12" Foreground="{StaticResource Muted}" Text="阅读 0%"/>
      <TextBlock Grid.Column="1" Text="青岚 · 一日一文" FontFamily="{StaticResource Literary}" Foreground="{StaticResource Muted}" FontSize="15"/>
    </Grid>
    <Grid.KeyboardAccelerators><KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked"/><KeyboardAccelerator Key="F11" Invoked="FullScreen_Invoked"/></Grid.KeyboardAccelerators>
  </Grid>
</Page>
