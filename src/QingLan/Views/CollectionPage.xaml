<Page x:Class="QingLan.Views.CollectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="30,22,30,24" MaxWidth="1180" RowSpacing="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="9"><TextBlock x:Name="Heading" FontSize="34" FontFamily="{StaticResource Literary}"/><TextBlock x:Name="Subheading" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel>
      <Button x:Name="WriteButton" Grid.Column="1" Content="写一页" VerticalAlignment="Center" Click="Write_Click"/>
    </Grid>
    <ListView x:Name="ArticleList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ArticleList_ItemClick" Background="Transparent">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Border Background="#D9FFFFFF" CornerRadius="18" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="23,20">
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="11">
                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Literary}" FontSize="26" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Author}" FontSize="12" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Summary}" FontSize="15" FontFamily="{StaticResource ReadingFont}" LineHeight="26" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ReadingTime}" Foreground="{StaticResource Muted}" FontSize="11"/>
              </StackPanel>
              <Button Grid.Column="1" Content="•••" VerticalAlignment="Top" Padding="12,5" AutomationProperties.Name="文章操作">
                <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="打开阅读" Tag="{Binding}" Click="Read_Click"/><MenuFlyoutItem Text="收藏 / 取消收藏" Tag="{Binding}" Click="Favorite_Click"/><MenuFlyoutItem Text="删除随心记" Tag="{Binding}" Click="Delete_Click"/></MenuFlyout></Button.Flyout>
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" MaxWidth="400">
      <FontIcon Glyph="&#xE8A5;" FontSize="44" Foreground="#88A7AE"/><TextBlock x:Name="EmptyTitle" FontFamily="{StaticResource Literary}" FontSize="29" HorizontalAlignment="Center"/>
      <TextBlock x:Name="EmptyDescription" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="14" LineHeight="25"/>
    </StackPanel>
  </Grid>
</Page>
