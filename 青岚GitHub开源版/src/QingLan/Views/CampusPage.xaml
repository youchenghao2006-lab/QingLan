<Page x:Class="QingLan.Views.CampusPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" NavigationCacheMode="Disabled">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,22,28,32" Spacing="22" MaxWidth="1440" HorizontalAlignment="Stretch">
      <Border Background="#E0EEEE" CornerRadius="24" Padding="26,22">
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="8">
            <TextBlock Text="CAMPUS  /  好好上课，也好好生活" FontSize="12" CharacterSpacing="80" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
            <TextBlock Text="把日子，排成喜欢的样子" FontFamily="{StaticResource Literary}" FontSize="30" TextWrapping="Wrap"/>
            <TextBlock x:Name="SemesterSummary" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          </StackPanel>
          <Border x:Name="DateBadge" Grid.Column="1" Background="#F8FCFA" CornerRadius="18" Padding="20,12" VerticalAlignment="Center">
            <StackPanel Spacing="4"><TextBlock Text="TODAY" FontSize="11" CharacterSpacing="160" Foreground="{StaticResource Accent}"/><TextBlock x:Name="TodayNumber" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="TodayWeekday" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
          </Border>
        </Grid>
      </Border>
      <InfoBar x:Name="CampusError" IsOpen="False" IsClosable="False" Severity="Error"/>
      <Border x:Name="SetupPanel" Visibility="Collapsed" Background="White" CornerRadius="22" Padding="26">
        <StackPanel Spacing="16"><TextBlock Text="新学期，从这里开始" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="先设置学期开始和结束日期，青岚会自动计算教学周。之后就能安排课程和备忘录了。" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button Content="设置学期起止日期 →" Click="Semester_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel>
      </Border>
      <StackPanel x:Name="CampusContent" Spacing="22">
        <StackPanel Spacing="12">
          <TextBlock Text="我的课表" FontSize="23" FontWeight="SemiBold"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,0,0,4">
              <Button x:Name="PreviousWeek" Content="‹" Click="PreviousWeek_Click" AutomationProperties.Name="上一周" Padding="16,10"/>
              <TextBlock x:Name="WeekLabel" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="108" TextAlignment="Center"/>
              <Button x:Name="NextWeek" Content="›" Click="NextWeek_Click" AutomationProperties.Name="下一周" Padding="16,10"/>
              <Button Content="本周" Click="TodayWeek_Click" Padding="14,10"/>
              <Button Content="＋ 课程" Click="AddCourse_Click" Style="{StaticResource PrimaryButton}"/>
              <Button Content="时段设置" Click="Periods_Click"/>
              <Button Content="学期设置" Click="Semester_Click"/>
              <Button Content="刷新" Click="Refresh_Click" Padding="14,10"/>
            </StackPanel>
          </ScrollViewer>
          <TextBlock x:Name="WeekHint" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <Border Background="#F9FCFA" BorderBrush="#D8E4E2" BorderThickness="1" CornerRadius="20" Padding="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <Grid x:Name="Timetable" MinWidth="830" ColumnSpacing="6" RowSpacing="6" Margin="0,0,0,8"/>
            </ScrollViewer>
          </Border>
          <Button x:Name="AllCoursesButton" Content="全部课程" Click="AllCourses_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,8"/>
          <StackPanel x:Name="AllCoursesPanel" Visibility="Collapsed" Spacing="8"/>
        </StackPanel>
        <Border Background="#FFFFFF" BorderBrush="#D8E4E2" BorderThickness="1" CornerRadius="22" Padding="22">
          <StackPanel Spacing="16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="5"><TextBlock Text="近期备忘录" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="MemoCount" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
              <Button Grid.Column="1" Content="＋ 记一件事" Click="AddMemo_Click" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel x:Name="MemoList" Spacing="10"/>
            <Button x:Name="AllMemosButton" Content="查看全部备忘录" Click="AllMemos_Click" HorizontalAlignment="Left" Padding="6,8" Background="Transparent" BorderThickness="0"/>
            <TextBlock Text="按开始时间从早到晚排列；过期事项保留至手动删除。点击事项可编辑，右侧 ✓ 确认后删除。" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <TextBlock Text="学习有节奏，生活有留白。" FontFamily="{StaticResource Literary}" FontSize="18" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
      </StackPanel>
      <Button x:Name="RetryLoadButton" Visibility="Collapsed" Content="重新读取校园日程" Click="Refresh_Click" HorizontalAlignment="Left"/>
    </StackPanel>
  </ScrollViewer>
</Page>
